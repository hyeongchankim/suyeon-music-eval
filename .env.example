# PostgreSQL 연결 문자열 (Neon / Supabase / Vercel Postgres 등)
# 예: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# iron-session 쿠키 암호화 키 — 32자 이상 임의 문자열
SESSION_PASSWORD="replace-with-a-random-string-at-least-32-characters-long"
