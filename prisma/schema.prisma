// 6. 데이터 모델 — PostgreSQL (Vercel 배포 및 로컬 개발 공통)
// 참고: majors / pieces 는 JSON 문자열로 저장한다 (SQLite 시절 호환 유지, parseList 로 파싱).
//       필요 시 String[] 로 전환 가능하나 현재는 유지.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id           String   @id @default(cuid())
  loginId      String   @unique // 참가자ID (영문+숫자)
  name         String
  phone        String
  email        String
  // ponytail: 기존 신청자가 있어 nullable로 추가. "필수 입력"은 신청서 zod 검증 +
  // 관리자 인원관리 편집 폼의 required 속성으로 강제하고, DB 제약으로는 강제하지 않음.
  currentSchool String? // 현재 재학중인 학교
  grade         String? // 학년
  homeAddress   String? // 집주소
  passwordHash String? // 선택 설정
  loginCount   Int      @default(0) // 5.3 — 3회 이상 로그인 시 비밀번호 설정 유도
  createdAt    DateTime @default(now())
  applications Application[]
}

model Round {
  id            String   @id @default(cuid())
  term          String // 예: "피아노 Season I"
  roundNo       Int // 1차, 2차 ...
  date          DateTime
  venue         String
  venueAddress  String
  majors        String   @default("[]") // JSON 배열 — 이 회차에서 응시 가능한 전공
  isOpen        Boolean  @default(true)
  arrivalNotice String? // 도착공지 텍스트/링크

  // 시간표 제작 설정
  ttStartTime String? // "HH:mm" — 시간표 시작 시각 (미지정이면 회차 일시의 시각)
  ttPerHour   Int      @default(10) // 시간당 인원
  ttMajorOrder String  @default("[]") // JSON 배열 — 전공 진행 순서
  ttSentAt    DateTime? // 마지막 시간표 전송 시각

  applications  Application[]
}

model Application {
  id               String   @id @default(cuid())
  studentId        String
  roundId          String
  majors           String // JSON 배열 문자열 (다중선택)
  advisorName      String?
  targetSchool     String
  pieceCount       Int
  pieces           String // JSON 배열 문자열 (곡명1~5)
  wantsScale       Boolean  @default(false)
  wantsBlind       Boolean  @default(false)
  wantsScoreReview Boolean  @default(false)
  preferredTime    String?
  questionForJudge String?
  agreedNotice     Boolean  @default(false)
  eventNickname    String?
  rankingOptIn     Boolean  @default(false)
  audioOptIn       Boolean  @default(false)
  status           String   @default("접수") // 접수/확정/취소
  paid             Boolean  @default(false) // 입금 확인
  ttOrder          Int? // 시간표 내 순서 (0부터, 미배정이면 null)
  createdAt        DateTime @default(now())

  student  Student      @relation(fields: [studentId], references: [id])
  round    Round        @relation(fields: [roundId], references: [id])
  scores   Score[]
  selfNote SelfNote?
  media    MediaAsset[]
}

model Score {
  id            String @id @default(cuid())
  applicationId String
  pieceNo       Int
  judge1        Float?
  judge2        Float?
  judge3        Float?
  judge4        Float?
  judge5        Float?
  average       Float? // 최고·최저 각 1개 제외 평균 (유효 점수 3개 미만이면 단순 평균)
  reportFileUrl String? // PDF 링크

  application Application @relation(fields: [applicationId], references: [id])
}

model SelfNote {
  id            String   @id @default(cuid())
  applicationId String   @unique
  goodPoints    String?
  improvePoints String?
  nextPractice  String?
  updatedAt     DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id])
}

model MediaAsset {
  id            String    @id @default(cuid())
  applicationId String
  type          String // "feedback" | "performance" | "audio"
  url           String
  downloadable  Boolean   @default(false)
  expiresAt     DateTime? // 예: 업로드 + 15일

  application Application @relation(fields: [applicationId], references: [id])
}

model AdminUser {
  id           String @id @default(cuid())
  username     String @unique // 관리자 로그인 아이디
  passwordHash String
  role         String @default("staff")
}
